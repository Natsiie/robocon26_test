<?xml version="1.0"?>
<robot name="simple_robot">

  <!-- 材料定义 -->
  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>
  <material name="red">
    <color rgba="0.8 0 0 1"/>
  </material>
  <material name="green">
    <color rgba="0 0.8 0 1"/>
  </material>
  <material name="yellow">
    <color rgba="0.8 0.8 0 1"/>
  </material>

  <!-- 1. 机器人底盘 -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.3"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.3"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <!-- 2. Yaw轴关节和连杆 -->
  <link name="robot_yaw">
    <visual>
      <geometry>
        <cylinder length="0.4" radius="0.04"/>
      </geometry>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.4" radius="0.04"/>
      </geometry>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="base_to_yaw_joint" type="continuous">
    <parent link="base_link"/>
    <child link="robot_yaw"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- 3. Pitch轴关节和连杆 -->
  <link name="robot_pitch">
    <visual>
      <geometry>
        <cylinder length="0.2" radius="0.03"/>
      </geometry>
      <material name="green"/>
      <origin xyz="0.1 0 0" rpy="0 1.5708 0"/> <!-- 旋转90度使圆柱体水平 -->
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.2" radius="0.03"/>
      </geometry>
      <origin xyz="0.1 0 0" rpy="0 1.5708 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02"/>
    </inertial>
  </link>

  <joint name="yaw_to_pitch_joint" type="revolute">
    <parent link="robot_yaw"/>
    <child link="robot_pitch"/>
    <origin xyz="0.0 0 0.3" rpy="0 0 0"/> <!-- 连接到yaw轴顶端 -->
    <axis xyz="0 1 0"/>
    <limit lower="-0.5236" upper="0.5236" effort="10.0" velocity="1.0"/> <!-- -30° to 30° -->
  </joint>

  <!-- 4. 相机连杆 -->
  <link name="robot_camera">
    <visual>
      <geometry>
        <box size="0.06 0.02 0.02"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.02 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="pitch_to_camera_joint" type="fixed">
    <parent link="robot_pitch"/>
    <child link="robot_camera"/>
    <origin xyz="0.2 0 0.04" rpy="0 0 0"/> <!-- 连接到pitch轴末端 -->
  </joint>

  <!-- 5. 雷达连杆 -->
  <link name="robot_lidar">
    <visual>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="yaw_to_lidar_joint" type="fixed">
    <parent link="robot_yaw"/>
    <child link="robot_lidar"/>
    <origin xyz="0 0.06 0.2" rpy="0 0 0"/> <!-- 连接到yaw轴中央左侧 -->
  </joint>
  
  <!-- 6. 雷达底座 -->
  <link name="robot_lidar_base"> 
  <visual>
      <geometry>
        <box size="0.06 0.06 0.03"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.04 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="lidar_to_base_joint" type="fixed">
    <parent link="robot_lidar"/>
    <child link="robot_lidar_base"/>
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
  </joint>
</robot>